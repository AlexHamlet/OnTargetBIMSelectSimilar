<Window x:Class="SelectSimilar.UI.wndSelectInstance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SelectSimilar.UI"
        mc:Ignorable="d"
        Icon="../Resources/OnTargetBIM.ico"
        Title="Select Instance" Height="450" Width="450" MinWidth="200" MinHeight="250" WindowStartupLocation="CenterScreen">
    <Grid x:Name="Master" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1*" Name="masterColumn0" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="masterColumn1" />
            <ColumnDefinition Width="1*" Name="masterColumn2" />
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <RadioButton x:Name="rdbtnView" Grid.Column="1" Grid.Row="1" GroupName="Scope" IsChecked="True" Content="View" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <RadioButton GroupName="Scope" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Content="Project" Margin="70,0,0,0" VerticalAlignment="Top"/>
        <GroupBox Header="Selected Element" Grid.Column="1" Grid.Row="2" VerticalAlignment="Top" Grid.ColumnSpan="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Path=Width, Mode=TwoWay, ElementName=masterColumn0}" MinWidth="40"/>
                    <ColumnDefinition Width="2" SharedSizeGroup="masterColumn1" />
                    <ColumnDefinition Width="{Binding Path=Width, Mode=TwoWay, ElementName=masterColumn2}" MinWidth="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="stpnlcatfamtypetitle">
                    <!--<CheckBox x:Name="cbCategory" IsChecked="True" IsEnabled="False" Content="Category:" Height="16" BorderBrush="#FF707070"/>
                    <CheckBox x:Name="cbFamily" IsChecked="True" IsEnabled="False" Content="Family:" Height="16"/>
                    <CheckBox x:Name="cbType" IsChecked="True" IsEnabled="False" Content="Type:" Height="16"/>-->
                </StackPanel>
                <StackPanel x:Name="stpnlcatfamtype" Grid.Column="2">
                </StackPanel>
                <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext" Width="2" 
                              Grid.RowSpan="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=RowDefinitions.Count, Mode=OneWay}" 
                              Background="#FF969696"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Instance Parameters" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="grdParams">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Path=Width, Mode=TwoWay, ElementName=masterColumn0}" MinWidth="40"/>
                        <ColumnDefinition Width="2" SharedSizeGroup="masterColumn1" />
                        <ColumnDefinition Width="{Binding Path=Width, Mode=TwoWay, ElementName=masterColumn2}" MinWidth="40"/>
                    </Grid.ColumnDefinitions>
                    <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext" Width="2" 
                                  Grid.RowSpan="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=RowDefinitions.Count, Mode=OneWay}" 
                                  Background="#FF969696"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>
        <Button x:Name="btnSelect" Content="Select" Margin="0,4,0,0" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="4" HorizontalAlignment="Right" Width="75" Click="btnSelect_Click"/>
        <Button x:Name="btnCancel" Content="Cancel" Margin="0,4,0,0" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="4" HorizontalAlignment="Left" Width="75" Click="btnCancel_Click"/>

    </Grid>
</Window>
